# ---------------------------------------------------------------------------
# Copia este fichero a .env y ajusta los valores.
#   cp .env.example .env      (Windows PowerShell: Copy-Item .env.example .env)
#
# NINGUN valor de este fichero tiene un valor por defecto en el codigo. Si falta
# una variable obligatoria, la parte del sistema que la necesita falla con un
# mensaje explicito en lugar de arrancar con una configuracion insegura.
#
# Genera secretos con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------

# ===========================================================================
#  Base de datos (PostgreSQL)
# ===========================================================================
# En produccion, el Postgres gestionado de Render. El disco de Render es
# efimero: con SQLite (file:...) cada redeploy borraria TODAS las noticias
# aprobadas y todo el historial de revision.
#
# Desarrollo local con Docker:
#   docker run -d --name lz-postgres -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=lanzarote -p 5432:5432 postgres:16-alpine
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lanzarote?schema=public"
DATABASE_URL="postgresql://usuario:CONTRASENA@localhost:5432/lanzarote?schema=public"

# ===========================================================================
#  Sitio
# ===========================================================================
# Sin barra final. Es la base de canonical, sitemap, RSS y Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ===========================================================================
#  Panel de administracion (/admin)
# ===========================================================================
# Sin valor por defecto. Si falta, el panel no deja entrar.
# Para produccion, una contrasena larga y unica de este sitio.
ADMIN_PASSWORD="cambia-esta-clave-por-una-larga-y-unica"

# Firma de la cookie de sesion. Minimo 32 caracteres. Si es corto, el panel no
# arranca. Generalo con el comando de arriba.
ADMIN_SESSION_SECRET="cambia-este-secreto-por-64-caracteres-aleatorios-hex"

# ===========================================================================
#  IA: reescritura de noticias (OpenRouter)
# ===========================================================================
# Sin esta clave el sistema funciona igual, pero las noticias se guardan con el
# texto original y sin reescribir. Nunca se publica nada automaticamente.
#
# La clave empieza por sk-or-v1- . Se obtiene en https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Modelo de redaccion.Uno economico y rapido basta: se trata de resumir y
# redactar, no de razonar. Opciones: google/gemini-flash-1.5,
# anthropic/claude-3.5-haiku, meta-llama/llama-3.3-70b-instruct.
OPENROUTER_MODEL="google/gemini-flash-1.5"

# Modelo de embeddings, para la similitud semantica de duplicados.
# Si falla, la deduplicacion sigue funcionando con SimHash y titular.
OPENROUTER_EMBEDDING_MODEL="openai/text-embedding-3-small"

OPENROUTER_APP_TITLE="Accidentes Lanzarote"
AI_TIMEOUT_MS="45000"
AI_MAX_RETRIES="2"

# ===========================================================================
#  Monitorizacion (el ciclo de un minuto)
# ===========================================================================
# Protege GET /api/cron/monitor. Sin esta variable el endpoint devuelve 503 y
# no hace nada. Minimo 24 caracteres.
#
# El cron EXTERNO llama a:
#   GET https://TU-DOMINIO/api/cron/monitor
#   Header: Authorization: Bearer <CRON_SECRET>
#
# Opciones de cron externo gratuito: cron-job.org, EasyCron, UptimeRobot.
# No uses el cron nativo de Render: solo existe en planes de pago y reinicia
# el proceso en cada ejecucion.
CRON_SECRET="genera-un-secreto-de-al-menos-24-caracteres"

# Cada cuanto se ejecuta el ciclo, en milisegundos. El requisito es 60000.
MONITOR_INTERVAL_MS="60000"

# Cuantas pasadas sin verse una URL hacen falta para marcarla como ausente.
# Importante: que una noticia salga del feed NO significa que se haya borrado;
# los medios solo muestran los ultimos articulos. Ninguna noticia publicada se
# retira por esto.
MONITOR_MISSING_THRESHOLD="6"

# Ventana de horas hacia atras que se consideran "noticia nueva" en cada pasada.
MONITOR_LOOKBACK_HOURS="48"

# Corte de antiguedad: nada de mas de N dias entra al sistema.
MONITOR_MAX_AGE_DAYS="30"

# Maximo de articulos revisados por fuente y pasada.
MONITOR_MAX_ARTICLES_PER_FEED="25"

# Fallos consecutivos antes de marcar una fuente como CAIDA y avisar.
FEED_FAILURE_THRESHOLD="3"

# Scheduler dentro del propio servidor. En produccion conviene DEJARLO EN false
# y usar el cron externo: el scheduler embebido se duerme con la web y, con
# varias instancias, el scraping se duplicaria.
ENABLE_EMBEDDED_SCHEDULER="false"

# ===========================================================================
#  Endpoint de ingesta (POST /api/ingest)
# ===========================================================================
# Permite que un script o un servicio externo envíe una noticia ya redactada.
# Sin esta variable el endpoint devuelve 503.
INGEST_WEBHOOK_SECRET=""

# ===========================================================================
#  Notificaciones
# ===========================================================================
# Todos los canales son opcionales. Si no hay ninguno, el sistema funciona igual
# y lo avisa al arrancar, pero no recibiras avisos de novedades.

# --- Email por SMTP ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
ADMIN_EMAIL=""
NOTIFY_FROM=""

# --- Telegram ---
# Se crea el bot con @BotFather, que devuelve el token.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Discord ---
# Server Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=""

# --- Webhook generico ---
# Recibe un POST con event="news.detected". Si defines NOTIFY_WEBHOOK_SECRET, la
# cabecera X-Signature lleva el HMAC-SHA256 del cuerpo.
NOTIFY_WEBHOOK_URL=""
NOTIFY_WEBHOOK_SECRET=""

# ===========================================================================
#  Imagenes
# ===========================================================================
# Directorio donde se guardan los WebP y las variantes, relativo al proyecto.
# Debe ser accesible desde public/ para que Next los sirva.
IMAGE_STORAGE_DIR="public/media"
IMAGE_PIPELINE_ENABLED="true"
IMAGE_MAX_WIDTH="2000"
IMAGE_WEBP_QUALITY="78"
# Descarta imagenes con alguna dimension menor que esto: suelen ser iconos.
IMAGE_MIN_DIMENSION="320"
IMAGE_TIMEOUT_MS="15000"

# ===========================================================================
#  Deduplicacion
# ===========================================================================
# Subir los umbrales hace que se fusionen mas noticias y se pierdan algunas
# distintas. Bajarlos deja pasar duplicados.
DEDUPE_TITLE_THRESHOLD="0.86"
DEDUPE_SIMHASH_DISTANCE="12"
DEDUPE_SEMANTIC_THRESHOLD="0.93"
DEDUPE_WINDOW_HOURS="72"

# ===========================================================================
#  Verificacion
# ===========================================================================
# Por debajo de VERIFY_MIN_CONFIDENCE la noticia queda SUSPICIOUS.
# A partir de VERIFY_GOOD_CONFIDENCE queda VERIFIED. En ambos casos sigue
# necesitando aprobacion manual: verificar no es publicar.
VERIFY_MIN_CONFIDENCE="0.55"
VERIFY_GOOD_CONFIDENCE="0.8"

# ===========================================================================
#  HTTP saliente (scraping)
# ===========================================================================
HTTP_TIMEOUT_MS="15000"
# Identifica el bot ante los medios. Usa un contacto real: asi, si un medio
# bloquea el acceso, hay quien pueda avisar.
HTTP_USER_AGENT="TraficoLanzaroteBot/2.0 (+https://TU-DOMINIO; contacto@TU-CORREO)"

# Desactiva la proteccion SSRF. SOLO para desarrollo local con Docker.
# En produccion debe ser false: en true, el monitor podria leer
# http://169.254.169.254 (credenciales de la nube) o el puerto del Postgres.
ALLOW_PRIVATE_FETCH="false"

# ===========================================================================
#  Observabilidad
# ===========================================================================
# debug | info | warn | error
LOG_LEVEL="info"

# ===========================================================================
#  Zona horaria
# ===========================================================================
# ATLANTIC/CANARY, no Europe/Madrid: en invierno las Canarias van una hora por
# detras de la peninsula peninsular. Usar la zona equivocada desplaza las fechas
# una hora durante siete meses al ano.
TZ="Atlantic/Canary"
