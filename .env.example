# ---------------------------------------------------------------------------
# Copia este fichero a .env y ajusta los valores
#   cp .env.example .env      (Windows PowerShell: Copy-Item .env.example .env)
# ---------------------------------------------------------------------------

# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:[REDACTADO]@localhost:5432/lanzarote_accidentes?schema=public"

# URL publica del sitio (se usa en SEO: canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Panel de administracion (/admin)
# ---------------------------------------------------------------------------
# Contrasena de acceso al panel. CAMBIALA en produccion.
ADMIN_PASSWORD="cambia-esta-clave"

# Secreto para firmar la cookie de sesion del panel.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="cambia-este-secreto-por-uno-aleatorio-de-64-caracteres"

# ---------------------------------------------------------------------------
# Integracion con IA (opcional, fase futura)
# ---------------------------------------------------------------------------
# Token que debe presentar la IA al enviar borradores a POST /api/ai/drafts
# Sin este valor el endpoint devuelve 503 y queda deshabilitado.
AI_WEBHOOK_SECRET=""

# Endpoint del proveedor de IA (futuro). Se deja vacio hasta conectarlo.
AI_PROVIDER_URL=""
AI_PROVIDER_API_KEY=""

# Zona horaria usada para interpretar fechas sin hora
TZ="Atlantic/Canary"
