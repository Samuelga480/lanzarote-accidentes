{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/accidentes/[slug]",
      "regex": "^/accidentes/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/accidentes/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/admin/[id]",
      "regex": "^/admin/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/admin/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/accidents/[slug]",
      "regex": "^/api/accidents/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/api/accidents/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/municipios/[slug]",
      "regex": "^/municipios/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/municipios/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/vehiculos/[slug]",
      "regex": "^/vehiculos/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/vehiculos/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/accidentes",
      "regex": "^/accidentes(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/accidentes(?:/)?$"
    },
    {
      "page": "/admin",
      "regex": "^/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin(?:/)?$"
    },
    {
      "page": "/admin/login",
      "regex": "^/admin/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/login(?:/)?$"
    },
    {
      "page": "/admin/nuevo",
      "regex": "^/admin/nuevo(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/nuevo(?:/)?$"
    },
    {
      "page": "/buscar",
      "regex": "^/buscar(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/buscar(?:/)?$"
    },
    {
      "page": "/mapa",
      "regex": "^/mapa(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/mapa(?:/)?$"
    },
    {
      "page": "/municipios",
      "regex": "^/municipios(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/municipios(?:/)?$"
    },
    {
      "page": "/privacidad",
      "regex": "^/privacidad(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/privacidad(?:/)?$"
    },
    {
      "page": "/robots.txt",
      "regex": "^/robots\\.txt(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/robots\\.txt(?:/)?$"
    },
    {
      "page": "/sitemap.xml",
      "regex": "^/sitemap\\.xml(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sitemap\\.xml(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}